# =============================================
# 3. WHY USE COMMENTS?
# =============================================
print("3. WHY USE COMMENTS?")

# Without comments - confusing!
x = 10
y = 5
z = (x * y) / 2

# With comments - clear!
base = 10        # Base of the triangle
height = 5       # Height of the triangle
area = (base * height) / 2  # Calculate triangle area

print(f"Area of triangle: {area}")
print()

# =============================================
# 4. COMMENTING BEST PRACTICES
# =============================================
print("4. COMMENTING BEST PRACTICES")

# Good: Explains WHY, not WHAT
# Calculate monthly compound interest
principal = 1000
rate = 0.05
time = 12
amount = principal * (1 + rate/12) ** time

# Bad: Just repeats what code does
# Multiply principal by 1 plus rate divided by 12 to the power of time
# amount = principal * (1 + rate/12) ** time

print(f"Investment growth: ${amount:.2f}")
print()

# =============================================
# 5. DOCSTRINGS - SPECIAL COMMENTS
# =============================================
print("5. DOCSTRINGS FOR FUNCTIONS")

def calculate_bmi(weight, height):
    """
    Calculate Body Mass Index (BMI)
    
    Args:
        weight (float): Weight in kilograms
        height (float): Height in meters
    
    Returns:
        float: BMI value
    """
    return weight / (height ** 2)

# Using the function
bmi = calculate_bmi(65, 1.65)
print(f"BMI: {bmi:.2f}")
print()

# =============================================
# 6. PRACTICAL COMMENTING EXAMPLE
# =============================================
print("6. PRACTICAL COMMENTING EXAMPLE")

# Data processing with comments
print("DATA PROCESSING EXAMPLE")

# Raw data from sensor
raw_temperatures = [22.5, 23.1, 21.8, 24.5, 20.9]

# Remove outliers (temperatures below 21 or above 24)
filtered_temps = [temp for temp in raw_temperatures if 21 <= temp <= 24]

# Calculate average temperature
average_temp = sum(filtered_temps) / len(filtered_temps)

print(f"Raw data: {raw_temperatures}")
print(f"Filtered: {filtered_temps}")
print(f"Average: {average_temp:.1f}°C")
print()

# =============================================
# 7. COMMON COMMENTING MISTAKES
# =============================================
print("7. COMMON COMMENTING MISTAKES TO AVOID")

# ❌ Bad: Obvious comments
